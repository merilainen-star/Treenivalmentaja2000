<?xml version="1.0" encoding="utf-8"?>
<!-- Lint reports ObsoleteSdkInt here and asks for this folder to be renamed to plain
     mipmap-anydpi now that minSdk is 26. Do not: the resource merger silently ignores the
     unversioned folder, without a warning, and the build then fails with
     "resource mipmap/ic_launcher not found". Measured on AGP with build-tools 36.1.0. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
