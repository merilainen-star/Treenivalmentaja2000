<?xml version="1.0" encoding="utf-8"?><!--
   Backups are disabled in the manifest. These exclusions are defence in depth if that policy is
   ever changed: health/training history and credentials must not silently leave the device.
-->
<full-backup-content>
    <!-- The Oura tokens are encrypted with a key that lives in the Android Keystore and cannot
         leave the device. Backing up the ciphertext would restore bytes onto a phone whose Keystore
         has no matching key, so the app would hold tokens it can never read. Excluded instead: a
         restored install simply asks to connect Oura again.
         See data/oura/OuraTokenStore.kt. -->
    <exclude domain="sharedpref" path="oura_tokens.xml"/>
    <!-- Same reasoning, the intervals.icu API key. See data/intervals/IntervalsApiKeyStore.kt. -->
    <exclude domain="sharedpref" path="intervals_credentials.xml"/>
    <exclude domain="sharedpref" path="analysis_anthropic_credentials.xml"/>
    <exclude domain="sharedpref" path="analysis_openai_credentials.xml"/>
    <exclude domain="sharedpref" path="analysis_gemini_credentials.xml"/>
    <!-- Room contains the complete plan, completed workouts and recovery data. There is no SQLCipher
         dependency because Android app-private storage plus full backup opt-out is the chosen threat
         boundary; a rooted/unlocked device is outside it. Plan import remains explicit and visible. -->
    <exclude domain="database" path="."/>
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
