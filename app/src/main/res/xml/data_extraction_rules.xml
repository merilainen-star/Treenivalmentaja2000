<?xml version="1.0" encoding="utf-8"?><!--
   Backups and device-to-device transfer are disabled in the manifest. Keep the sensitive domains
   excluded here too so a future manifest change cannot accidentally export them.
-->
<data-extraction-rules>
    <!-- Excluded from both, for the same reason and not only from the cloud: the Keystore key the
         Oura tokens are encrypted with does not travel to the new device either, so transferred
         ciphertext would be unreadable there too. See data/oura/OuraTokenStore.kt. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="oura_tokens.xml"/>
        <exclude domain="sharedpref" path="intervals_credentials.xml"/>
        <exclude domain="sharedpref" path="analysis_anthropic_credentials.xml"/>
        <exclude domain="sharedpref" path="analysis_openai_credentials.xml"/>
        <exclude domain="sharedpref" path="analysis_gemini_credentials.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="oura_tokens.xml"/>
        <exclude domain="sharedpref" path="intervals_credentials.xml"/>
        <exclude domain="sharedpref" path="analysis_anthropic_credentials.xml"/>
        <exclude domain="sharedpref" path="analysis_openai_credentials.xml"/>
        <exclude domain="sharedpref" path="analysis_gemini_credentials.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
