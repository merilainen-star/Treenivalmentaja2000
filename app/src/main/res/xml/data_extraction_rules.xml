<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Excluded from both, for the same reason and not only from the cloud: the Keystore key the
         Oura tokens are encrypted with does not travel to the new device either, so transferred
         ciphertext would be unreadable there too. See data/oura/OuraTokenStore.kt. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="oura_tokens.xml"/>
        <exclude domain="sharedpref" path="strava_tokens.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="oura_tokens.xml"/>
        <exclude domain="sharedpref" path="strava_tokens.xml"/>
    </device-transfer>
</data-extraction-rules>
